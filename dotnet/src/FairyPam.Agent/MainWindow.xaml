<Window x:Class="FairyPam.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FairyPam Agent"
        Width="460"
        Height="470"
        MinWidth="420"
        MinHeight="430"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="FairyPam Agent" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray" Text="设备运行状态" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Margin="0,8" Text="设备" />
      <TextBlock x:Name="DeviceStatusText" Grid.Column="1" Margin="0,8" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Margin="0,8" Text="控制通道" />
      <TextBlock x:Name="ControlStatusText" Grid.Row="1" Grid.Column="1" Margin="0,8" FontWeight="SemiBold" />
      <TextBlock Grid.Row="2" Margin="0,8" Text="画面通道" />
      <TextBlock x:Name="FrameStatusText" Grid.Row="2" Grid.Column="1" Margin="0,8" FontWeight="SemiBold" />
      <TextBlock Grid.Row="3" Margin="0,8" Text="安全状态" />
      <TextBlock x:Name="SafetyStatusText" Grid.Row="3" Grid.Column="1" Margin="0,8" FontWeight="SemiBold" />
    </Grid>

    <StackPanel Grid.Row="4">
      <TextBlock FontWeight="SemiBold" Text="注册设备" />
      <TextBlock Margin="0,4,0,10" Foreground="DimGray" Text="输入管理员生成的一次性注册码。" />
      <PasswordBox x:Name="EnrollmentCodeBox" MaxLength="256" />
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
        <Button x:Name="RegisterButton" Width="112" Padding="12,6" Click="Register_Click" Content="注册" />
        <Button x:Name="RescanButton" Width="112" Margin="12,0,0,0" Padding="12,6" Click="Rescan_Click" Content="重新扫描游戏" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="6"
               Foreground="DimGray"
               Text="关闭窗口后，Agent 会继续在系统托盘运行。" />
  </Grid>
</Window>
