{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum production capability for the unprivileged Agent UI",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-query-agent-status",
    "allow-query-suite-status",
    "allow-query-diagnostics",
    "allow-run-doctor",
    "allow-list-profiles",
    "allow-list-targets",
    "allow-select-target",
    "allow-focus-target",
    "allow-close-target",
    "allow-capture-preview",
    "allow-request-update",
    "allow-set-autostart",
    "allow-emergency-release-all"
  ]
}
