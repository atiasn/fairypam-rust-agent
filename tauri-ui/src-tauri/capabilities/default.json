{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for FairyPam Agent UI",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:window:default",
    "core:menu:default",
    "core:tray:default",
    "allow-get-overview",
    "allow-get-connection-status",
    "allow-run-environment-check",
    "allow-get-log-tail",
    "allow-scan-installed-games",
    "allow-register-hub",
    "allow-ensure-local-agent",
    "allow-restart-local-agent",
    "allow-repair-agent-tasks"
  ]
}
